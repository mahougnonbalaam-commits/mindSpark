# Copier ce fichier en .env puis renseigner les valeurs de votre projet Supabase
# (Project Settings -> API). Ces deux valeurs sont publiques par conception :
# l'accès est protégé par les règles RLS et l'Edge Function "generate".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ⚠️ La clé Gemini ne va PAS ici : tout ce qui commence par VITE_ est intégré en clair
# dans le JavaScript public. Elle se configure côté serveur :
#   supabase secrets set GEMINI_API_KEY=...
